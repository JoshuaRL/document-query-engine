# GitHub token for ingestion. Optional — if blank, the `gh` CLI token is used
# (run `gh auth login`). Or paste a personal access token (public_repo / repo scope).
GITHUB_TOKEN=

# LLM for query synthesis + the chat agent. Set ONE of the two below.
# If OPENAI_API_KEY is set, the engine uses OpenAI; otherwise it uses Anthropic.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Or a self-hosted OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp, a gateway).
# Setting LLM_BASE_URL selects it; see "Using a self-hosted OpenAI-compatible server" in the README.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=            # if your server needs one; falls back to OPENAI_API_KEY
# LLM_MODEL=              # required for a self-hosted server, e.g. qwen3:8b
# Optional:
# LLM_PROVIDER=           # openai | anthropic | openai-compatible (default: inferred)
# LLM_API=                # chat | responses (default: chat for a self-hosted server, responses for OpenAI)
# LLM_SYNTH_MODEL=        # per-role overrides of LLM_MODEL; also work with OpenAI and Anthropic
# LLM_CHAT_MODEL=
# LLM_REASONING=          # auto | on | off (default auto: on for gpt-5* / o* model names)

# Local MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=workshop

# Your GitHub login — treated as "me" / "my" in natural-language queries
CALLER_LOGIN=
